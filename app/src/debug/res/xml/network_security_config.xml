<?xml version="1.0" encoding="utf-8"?>
<!-- 仅 Debug：允许用户 CA 与 localhost 明文，用于本地端到端验证。Release 不含此文件。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
