<?xml version="1.0" encoding="utf-8"?>
<!--
  备份与设备迁移策略（Android 12+）：
  - 规则、书架、进度、设置随设备迁移保留，方便用户换机；
  - 下载的图片体积大且可从源重新获取，排除；
  - 不包含任何凭据（当前版本无 WebDAV 凭据）。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="Manga/downloaded" />
        <exclude domain="cache" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="Manga/downloaded" />
        <exclude domain="cache" />
    </device-transfer>
</data-extraction-rules>
